{
  "name": "property-value-enhancement",
  "version": "1.0.0",
  "description": "Property Value Enhancement Platform for Indian Middle-Class Homeowners",
  "private": true,
  "scripts": {
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "backend:check": "npm --prefix backend run test -- --runInBand --passWithNoTests",
    "build-all": "npm run build && npm run backend:check",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "property",
    "enhancement",
    "india",
    "real-estate",
    "home-improvement",
    "value-addition"
  ],
  "devDependencies": {
    "babel-jest": "^30.2.0",
    "concurrently": "^7.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "dependencies": {
    "react-spinners": "^0.17.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
